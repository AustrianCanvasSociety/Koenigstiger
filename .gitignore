!.claude/swarm/*/
!.claude/swarm/*/input.json
!.claude/swarm/*/results.json
!.claude/swarm/*/registry.json
!.claude/swarm/*/transcripts.json
.claude/session-boot/
.claude/session.id
.claude/routing/
.claude/state-events.jsonl
.claude/session-notes/
.claude/read-events.jsonl
.claude/.backlog-last-read
.claude/session-carry.md
.claude/step-carry.md
